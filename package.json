{
  "name": "adfish",
  "version": "1.0.2",
  "description": "摸鱼助手（adfish）：广告外观的小窗口浏览器，支持悬停切换与隐身模式",
  "main": "main.js",
  "private": true,
  "scripts": {
    "postinstall": "install-electron",
    "start": "electron .",
    "test": "node --test url.test.js",
    "package": "electron-packager . adfish --icon=assets/adfish.ico --platform=win32 --arch=x64 --out=release-build --overwrite --ignore=release --ignore=dist --ignore=data --ignore=webview2 --ignore=electron-runtime --ignore=\\.test\\.js$ --ignore=qa",
    "dist:windows": "node build-distribution.cjs",
    "verify:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/verify-distribution.ps1"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "@electron/packager": "20.3.0",
    "playwright": "1.64.0"
  },
  "productName": "adfish",
  "license": "MIT"
}
